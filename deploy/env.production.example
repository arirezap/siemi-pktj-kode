# Salin ke server/.env di SERVER, lalu isi JWT_SECRET.
# Buat nilai acak:  openssl rand -hex 48
# JANGAN pernah membagikan atau meng-commit berkas .env.

PORT=4000
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-48

# Opsional: lokasi basis data & unggahan (bawaan: server/data)
# DATA_DIR=/var/lib/siemi-pktj
